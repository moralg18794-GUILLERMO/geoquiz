# La configuración y el módulo de base de datos no se sirven nunca por HTTP.
# Son PHP y de por sí no devolverían código fuente, pero si algún día PHP dejara
# de ejecutarse en esta carpeta quedarían expuestas las credenciales.
<FilesMatch "^(config|config\.example|db)\.php$">
  Require all denied
</FilesMatch>
# preguntas.json lleva la respuesta correcta de las 521 preguntas (ans): es lo que
# necesita duelo.php para no fiarse del navegador, pero si se sirviera tal cual por
# HTTP cualquiera podría pedirla con curl y tener las respuestas de antemano, igual
# que pasó con los JSON de los torneos en GitHub Pages. Solo la lee PHP por dentro.
<Files "preguntas.json">
  Require all denied
</Files>
Options -Indexes
