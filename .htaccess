# GeoQuiz — cabeceras de caché.
#
# Hasta ahora no había ningún .htaccess en la raíz y todo eran los valores por defecto de
# Hostinger. El problema: el HTML salía SIN Cache-Control, solo con ETag, así que el
# navegador le aplicaba caché heurística. Todo el mecanismo de ?v= depende de que el HTML
# se revalide —es quien decide qué versión de los .js y .css se carga— y eso no estaba
# garantizado por ninguna cabecera: funcionaba por costumbre del servidor, no por contrato.
#
# mod_headers puede no estar en un hosting compartido, así que va todo dentro del IfModule:
# si falta, el sitio sigue sirviéndose igual en vez de responder un 500.
<IfModule mod_headers.c>
    # El HTML, siempre revalidado. "no-cache" no quiere decir "no lo guardes": quiere decir
    # "guárdalo pero pregunta antes de usarlo", que es exactamente lo que hace falta aquí.
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # El CSS y el JS van versionados con ?v= en la URL, así que para una URL dada el
    # contenido no cambia nunca: se pueden cachear un año y marcarlos como inmutables.
    # Antes eran 7 días sin immutable, y quien volvía a los ocho días revalidaba 15
    # archivos sin necesidad.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico|woff2)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>

    # La API no se cachea nunca: devuelve la clasificación del torneo en vivo.
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store"
    </FilesMatch>
</IfModule>
