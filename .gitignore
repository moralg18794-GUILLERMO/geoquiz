# Windows / macOS
Thumbs.db
desktop.ini
.DS_Store

# Editores
.vscode/
.idea/
*.swp

# Paquetes de despliegue
*.zip

# Credenciales: solo en el servidor
api/config.php

# Lleva la respuesta correcta de las 521 preguntas (ans). Si se versionara, el
# repositorio público la publicaría en GitHub Pages igual que pasó con los JSON de
# los torneos: se regenera sola con tools/exportar-preguntas.php y solo vive en
# local y en el servidor.
api/preguntas.json

# Los JSON de los torneos llevan el `ans` y la explicación de cada pregunta. El
# repositorio es público y GitHub Pages sirve su raíz tal cual, así que versionarlos
# publicaba el examen de la semana en la misma web desde la que se juega: cualquiera
# podía pedir torneos/<slug>.json y sacar las quince respuestas. Viven solo en local,
# que es de donde los lee tools/publicar-torneo.sh para mandarlos al servidor.
# El calendario sí se versiona: no lleva respuestas.
torneos/*.json
